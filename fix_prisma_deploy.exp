#!/usr/bin/expect -f
set timeout 120
set ip "85.121.178.80"
set password "kQkrGBYHtY76dIF0z1"

spawn scp -o StrictHostKeyChecking=no prisma/schema.prisma root@$ip:/opt/724bets-backend/prisma/schema.prisma
expect "*?assword:*"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no socket_server.cjs root@$ip:/opt/724bets-backend/socket_server.cjs
expect "*?assword:*"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no .env root@$ip:/opt/724bets-backend/.env
expect "*?assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no root@$ip "cd /opt/724bets-backend && npx prisma generate && pm2 restart 724bets-api"
expect "*?assword:*"
send "$password\r"
expect eof
