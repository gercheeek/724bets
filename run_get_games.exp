#!/usr/bin/expect -f
set timeout 120
set ip "85.121.178.80"
set password "kQkrGBYHtY76dIF0z1"

spawn scp -o StrictHostKeyChecking=no get_pragmatic_games.cjs root@$ip:/opt/724bets-backend/
