#!/usr/bin/expect -f
spawn ssh -o StrictHostKeyChecking=no root@85.121.178.80
expect "*?assword:*"
send "kQkrGBYHtY76dIF0z1\r"
expect "#"
send "sed -i 's/provider = \"prisma-client-js\"/provider = \"prisma-client-js\"\\n  previewFeatures = \\\[\"driverAdapters\"\\\]/' /opt/724bets-backend/prisma/schema.prisma\r"
expect "#"
send "cd /opt/724bets-backend && npx prisma generate\r"
expect "#"
send "pm2 restart 724bets-api\r"
expect "#"
send "cat /etc/nginx/sites-enabled/default > /tmp/nginx-config\r"
expect "#"
send "sed -i '/location \\/api\\/ {/i \\    location \\/socket.io\\/ {\\n        proxy_pass http:\\/\\/127.0.0.1:3001\\/socket.io\\/;\\n        proxy_http_version 1.1;\\n        proxy_set_header Upgrade \\$http_upgrade;\\n        proxy_set_header Connection \"upgrade\";\\n        proxy_set_header Host \\$host;\\n    }\\n' /etc/nginx/sites-enabled/default\r"
expect "#"
send "systemctl restart nginx\r"
expect "#"
send "exit\r"
expect eof
