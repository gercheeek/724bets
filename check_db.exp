#!/usr/bin/expect -f
set timeout -1
set ip "85.121.178.80"
set password "kQkrGBYHtY76dIF0z1"

spawn ssh -o StrictHostKeyChecking=no root@$ip "apt-get update && apt-get install -y sqlite3 && cd /opt/724bets-backend && sqlite3 dev.db 'SELECT id, userId, type, method, amount, status, txHash, createdAt FROM PaymentRequest WHERE type=\"withdraw\" ORDER BY createdAt DESC LIMIT 5;'"
